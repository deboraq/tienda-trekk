rules_version = '2';

// Email del usuario admin (Authentication) — tiene que coincidir EXACTO con el que usás al entrar.
// Para otro correo, cambiá esta línea y volvé a publicar reglas (Firebase Console o firebase deploy).
service cloud.firestore {
  match /databases/{database}/documents {
    function isCatalogAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "debocab2@gmail.com";
    }

    /** El cliente acepta el pedido modificado por la tienda (solo esos campos cambian). */
    function clienteAceptaPedidoModificado() {
      return request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.confirmacionModificacion == 'pendiente'
        && request.resource.data.confirmacionModificacion == 'aceptada'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.status == resource.data.status
        && request.resource.data.stockCommitted == resource.data.stockCommitted
        && request.resource.data.clientPhone == resource.data.clientPhone;
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isCatalogAdmin();
    }

    match /productos/{productId} {
      allow read: if true;
      allow create: if isCatalogAdmin();
      allow update, delete: if isCatalogAdmin();
    }

    // Pedidos web: el cliente crea el suyo (estado inicial fijo); solo el admin actualiza.
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isCatalogAdmin()
      );
      // userId es la fuente de verdad; userEmail es solo informativo (evita fallos por casing / token).
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 320
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.matches('^[0-9]{10,15}$')
        && request.resource.data.status == 'recibido'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && (!request.resource.data.keys().hasAny(['stockCommitted']) || request.resource.data.stockCommitted == true)
        && (!request.resource.data.keys().hasAny(['confirmacionModificacion']) || request.resource.data.confirmacionModificacion == 'no_aplica');
      allow update: if isCatalogAdmin() || clienteAceptaPedidoModificado();
      allow delete: if isCatalogAdmin();
    }
  }
}
